OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
OPENAI_CHAT_MODEL=gpt-4o
# Optional. When unset, main.py uses its public-safe default instructions.
OPENAI_SYSTEM_INSTRUCTIONS=
CORS_ALLOWED_ORIGINS=https://omshewale.me,http://localhost:5173,https://jarvis-interface.vercel.app
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# Supabase project used for note reactions (likes/dislikes) and comments.
SUPABASE_URL=
# service_role key — backend-only, never expose to the frontend bundle.
SUPABASE_KEY=
COMMENT_MAX_LENGTH=1000
COMMENT_RATE_LIMIT_REQUESTS=5
COMMENT_RATE_LIMIT_WINDOW_SECONDS=300
COMMENT_IP_RATE_LIMIT_REQUESTS=10
COMMENT_IP_RATE_LIMIT_WINDOW_SECONDS=300
REACTION_RATE_LIMIT_REQUESTS=20
REACTION_RATE_LIMIT_WINDOW_SECONDS=60

# Page view tracking (uses the same Supabase project as above).
PAGEVIEW_RATE_LIMIT_REQUESTS=60
PAGEVIEW_RATE_LIMIT_WINDOW_SECONDS=60
